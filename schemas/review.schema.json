        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "advisory"] },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "how_it_happens": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
