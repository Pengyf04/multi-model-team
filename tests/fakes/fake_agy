#!/usr/bin/env python3
"""测试用的假 agy：记录调用参数，按环境变量模拟各种情况。"""

import json
import os
import sys
import time

with open(os.environ["FAKE_LOG"], "a", encoding="utf-8") as f:
    record = {"argv": sys.argv[1:], "cwd": os.getcwd()}
    if os.environ.get("FAKE_AGY_LIST"):  # 记录工作目录里能看到的全部文件
        record["files"] = sorted(
            os.path.relpath(os.path.join(d, n), os.getcwd()) for d, _, names in os.walk(os.getcwd()) for n in names
        )
    f.write(json.dumps(record, ensure_ascii=False) + "\n")

time.sleep(float(os.environ.get("FAKE_SLEEP", "0")))
if os.environ.get("FAKE_AGY_TOUCH"):  # 模拟总指挥同时在改原目录
    with open(os.environ["FAKE_AGY_TOUCH"], "w") as f:
        f.write("claude edit")
if os.environ.get("FAKE_AGY_WRITE"):
    with open(os.environ["FAKE_AGY_WRITE"], "w") as f:
        f.write("x")

status = os.environ.get("FAKE_AGY_STATUS", "SUCCESS")
print(
    json.dumps(
        {
            "conversation_id": "conv-1",
            "status": status,
            "response": f"回答，见 {os.getcwd()}/a.txt\n",
            "error": "boom" if status != "SUCCESS" else None,
            "duration_seconds": 0.1,
            "num_turns": 1,
            "usage": {"total_tokens": 10},
        }
    )
)
sys.exit(0 if status == "SUCCESS" else 1)
